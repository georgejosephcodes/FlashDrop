{
  "name": "flashdrop",
  "version": "1.0.0",
  "description": "High-concurrency flash sale & ticket booking engine — Redis Streams + Write-Behind + WebSockets",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/orderProcessorWorker.js",
    "test": "jest --runInBand",
    "benchmark": "node benchmark/load-test.js",
    "verify": "node benchmark/verify-integrity.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "keywords": [
    "redis",
    "streams",
    "websockets",
    "flash-sale",
    "high-concurrency",
    "lua",
    "postgresql"
  ],
  "author": "George Joseph",
  "license": "MIT",
  "dependencies": {
    "@clerk/express": "^2.0.0",
    "@scalar/express-api-reference": "^0.4.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "nodemonConfig": {
    "ignore": [
      "benchmark/*",
      "*.test.js"
    ]
  }
}
