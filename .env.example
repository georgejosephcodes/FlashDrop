# ──────────────────────────────────────────────────────────────────────────
# FlashDrop — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
INSTANCE_ID=local

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Use 'postgres' as host when running inside Docker Compose
# Use 'localhost' (port 5433) when connecting from your host machine directly
DATABASE_URL=postgresql://flashdrop:flashdrop@postgres:5432/flashdrop

# ── Redis ─────────────────────────────────────────────────────────────────
# Use 'redis' as host when running inside Docker Compose
# Use 'localhost' (port 6380) when connecting from your host machine directly
REDIS_URL=redis://redis:6379

# ── Clerk (get from clerk.com dashboard → API Keys) ───────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# ── Dev flags ────────────────────────────────────────────────────────────────
# Set to true to bypass Clerk auth entirely during local testing.
# Use x-dev-user-id header to set userId (defaults to "dev_user_001").
# NEVER set this in production.
SKIP_AUTH=false

# Rate limit per second per IP (raise for benchmarking, keep low in production)
RATE_LIMIT_PER_SECOND=20
HOLD_TTL_SECONDS=600

# ── Write-Behind flush settings ───────────────────────────────────────────
SYNC_BATCH_SIZE=50
SYNC_INTERVAL_MS=500

